# --- Telegram ---
TELEGRAM_BOT_TOKEN=

# --- Ollama Cloud ---
OLLAMA_API_KEY=
OLLAMA_MODEL=minimax-m3:cloud
OLLAMA_BASE_URL=https://ollama.com/api
OLLAMA_TIMEOUT=60

# --- Limits ---
DAILY_GENERATION_LIMIT=2
MIN_SLIDES=3
MAX_SLIDES=25
DEFAULT_SLIDES_MIN=8
DEFAULT_SLIDES_MAX=10
MAX_PHOTOS=7
MAX_PHOTO_SIZE_MB=10
MAX_OUTPUT_SIZE_MB=50

# --- Storage / FS ---
SQLITE_PATH=./data/bot.db
TMP_DIR=./tmp

# --- Misc ---
TZ=Europe/Moscow
LOG_LEVEL=INFO
TEMPLATES_DIR=./templates